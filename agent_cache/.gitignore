# The repo root ignores *.log, *.csv, *.png and *.jsonl. Inside this directory
# those files are measured evidence, so re-include them (a nested .gitignore
# overrides the parent's patterns).
!*.log
!*.csv
!*.png
!*.jsonl
# raw datasets stay outside the repo (/home/wanhr/data); never commit them
*.parquet
data/
