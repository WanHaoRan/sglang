# The ten cache-rule switches of the unified arm (appended to a campaign's settings.env before that arm starts; the
# earlier engine copies do not read them). Read-or-recompute by price stays off: on the simulator it loses in every
# setting (design_unified_1126/sim/POLICY_RESULTS.md). The load hold is a separate switch
# (SGLANG_HICACHE_PREFILL_LOAD_HOLD_STEPS), on in campaigns 39 to 43.
SGLANG_LOG_HICACHE_PRICES_INTERVAL=10
SGLANG_HICACHE_NEXT_TURN_MEASURED_PRICES=1
SGLANG_HICACHE_NEXT_TURN_LATENESS_WEIGHT=1
SGLANG_HICACHE_NEXT_TURN_READ_LINE=1
SGLANG_HICACHE_NEXT_TURN_HOLD_QUANTILE=1
SGLANG_HICACHE_NEXT_TURN_FREE_EMPTY_LOOKUPS=1
SGLANG_HICACHE_STORAGE_TRACK_STORED=1
SGLANG_HICACHE_STORAGE_SKIP_ENDED_WRITES=1
SGLANG_HICACHE_NIXL_TOUCH_INTERVAL_S=300
SGLANG_HICACHE_NIXL_RETIRE_ENDED_PAGES=1
