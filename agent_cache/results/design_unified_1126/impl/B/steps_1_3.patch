+
+    def test_a_refreshed_chain_loses_its_tail_before_its_head(self):
+        """Pages are written head first, so the cleaner takes a chain's head first and
+        a lookup, which stops at the first missing page, then finds none of the rest.
+        A refresh stamps the head newest: the pass takes the tail and the head stays."""
