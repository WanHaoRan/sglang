+        parent_id,
+        RadixKey(array("q", tokens)),
+        torch.arange(len(tokens)),
+        # Page keys are hex digests: a child's key chains from its parent's last one.
+        [f"{token:064x}" for token in tokens],
+    ).inserted_host_node
