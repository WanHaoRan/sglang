+    """The hicache-l3-touch thread: does the queued jobs until the stop wake-up (None),
+    a backend dropped without close(), or close() giving up on it."""
+    stamped = missing = 0
+    last_log = time.monotonic()
+    stopping = False
+    while not stopping:
+        try:
