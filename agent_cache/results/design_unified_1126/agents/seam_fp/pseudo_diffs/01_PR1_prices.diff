+    def _follow_ready(self, waiting_queue: list[Req], *, now: float) -> int:
+        """Queued turns that have had no read of their own under way for NTP_GPU_BOUND_S: waiting for the GPU."""
+        if not (self._expected_cost or self._prices is not None):
+            return 0
+        cache = self._tree_cache
+        ready_since = {}
+        for req in waiting_queue:
+            if not cache.has_ongoing_prefetch(req.cache_request_handle):
+                ready_since[req.rid] = self._ready_since.get(req.rid, now)
+        self._ready_since = ready_since
+        return sum(now - since >= NTP_GPU_BOUND_S for since in ready_since.values())
