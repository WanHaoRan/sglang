@@ class NextUseStrategy  (after get_priority, line 172)
+    def holding_rate(self, node: TreeNode) -> Optional[float]:
+        """Per second, for the price of host room: 1 / seconds to the registered next use; 0 for an ended or
+        overdue session; None when unregistered or queued (no priced holder)."""
+        known, next_use = self.registry.lookup(node.id)
+        if not known or isinstance(next_use, Queued):
+            return None
+        if next_use is None:
+            return 0.0
+        left = next_use - self._clock()
+        return 0.0 if left < -self.overdue_grace_s else 1.0 / max(left, HOLDING_MIN_HORIZON_S)
@@ class ReturnChanceStrategy  (after get_priority, line 271)
+    def holding_rate(self, node: TreeNode) -> Optional[float]:
+        known, forecast = self._session_registration(node)
+        if not known or isinstance(forecast, Queued):
+            return None
+        if forecast is None:
+            return 0.0
+        idle = max(0.0, self._clock() - forecast.idle_from)
+        if forecast.dist.is_point:
+            left = forecast.dist.median_s - idle
+            return 0.0 if left < -POINT_GRACE_S else 1.0 / max(left, HOLDING_MIN_HORIZON_S)
+        return forecast.dist.holding_rate(idle_s=idle, min_horizon_s=HOLDING_MIN_HORIZON_S)
+# Arbitrary: no copy is dropped and read back faster than about one read.
+HOLDING_MIN_HORIZON_S = 0.5

