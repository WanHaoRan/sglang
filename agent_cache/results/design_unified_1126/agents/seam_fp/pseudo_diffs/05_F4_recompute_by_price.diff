+    def _recompute_pricing(self, handle, *, matched: int, missing: int, total: int) -> dict:
+        """Read-or-recompute for a turn at the gate: recompute when its GPU time, at the price of GPU time,
+        costs less than the stall the read adds. Only with nobody else queued and before this turn has itself
+        waited for the GPU: behind a queue the read is hidden and GPU time is dear, which is today's path."""
+        now = self._last_now
+        others = len(self._queued) - (handle.rid in self._queued)
+        since = self._ready_since.get(handle.rid)
+        if others > 0 or (since is not None and now - since >= NTP_GPU_BOUND_S):
+            return {}
+        board = self._prices
+        cost = self._prefill_cost
+        # What the missing history adds to this turn's prefill: it prefills total - matched tokens without the
+        # read and total - matched - missing with it.
+        recompute_s = cost.seconds(new_tokens=total - matched, total_tokens=total) - cost.seconds(
+            new_tokens=total - matched - missing, total_tokens=total
+        )
+        pages = math.ceil(missing / self._page_size)
+        read_s = self._load.seconds(
+            own_pages=pages, backlog_pages=self._tree_cache.storage_read_line_pages(None)
+        )
+        wins = recompute_wins(
+            recompute_s=recompute_s,
+            read_s=read_s,
+            queue_wait_s=0.0,
+            mu=board.mu(now),
+            lateness_weight=board.c(now),
+            device_s=pages * self._load.read_s_per_page,
+            kappa=board.kappa(now),
+        )
+        return {"wins": wins, "rec_ms": _ms(recompute_s), "read_ms": _ms(read_s),
+                "mu": f"{board.mu(now):.1f}", "c": f"{board.c(now):.2f}"}

How it is undone when load builds. The answer is per call and spends nothing. If the turn is not admitted in the
next passes (the KV pool or the batch is full), the queue check re-asks every PROBE_INTERVAL_S = 0.5 s
(_check_queued -> _wants_refetch -> Scheduler._on_next_turn_refetch -> _prefetch_kvcache -> gate,
next_turn_prefetch.py:826-944, scheduler.py:3211-3218); by then the turn has waited NTP_GPU_BOUND_S with nothing
to read, or others have queued, so _recompute_pricing returns {} and the gate answers read as today. The admission
re-query (_prefetch_after_device_hit_loss, scheduler.py:3240-3267) goes through the same gate.
A staged read already under way for the handle is joined before the gate (2145) and is not cancelled.

