+    def _agree_stored(self, operations, *, synced: bool) -> list[bool]:
+        """Whether each acked write covered all its pages. completed_tokens is this rank's
+        own count, so with several TP ranks the verdict is the MIN over ranks; a rank that
+        writes nothing for a replicated pool (backup_skip) votes yes."""
+        cc = self.cache_controller
+        local = [
+            cc.backup_skip
+            or operation.completed_tokens >= len(operation.hash_value) * self.page_size
+            for operation in operations
+        ]
+        if not (self._track_stored and synced and local and self.tp_world_size > 1):
+            return local
+        votes = torch.tensor(local, dtype=torch.int)
+        self._all_reduce_attn_groups(votes, torch.distributed.ReduceOp.MIN)
+        return [bool(vote) for vote in votes.tolist()]
