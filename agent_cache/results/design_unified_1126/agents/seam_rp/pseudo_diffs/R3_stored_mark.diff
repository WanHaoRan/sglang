# R3: a page counts as on the SSD only when the whole write is acknowledged.
# Pseudo-diff against HEAD b7074d9cae; not applied.
# State: two fields on the tree node, scheduler thread only. The write thread never sees them.

--- a/python/sglang/srt/mem_cache/unified_cache/unified_tree_core.py
+++ b/python/sglang/srt/mem_cache/unified_cache/unified_tree_core.py
@@ -132,6 +132,10 @@ class UnifiedTreeNode:
         self._tlru_history_len = 0
         self.external_cache_stored = False
+        # Host->storage write: the queued op's id, and whether every page of the node has
+        # an acked storage copy (a full ack, or pages read back from storage).
+        self.storage_write_op: Optional[int] = None
+        self.storage_stored = False
         self.priority = priority
@@ -1404,6 +1408,9 @@ def _split_node(
         new_node.hit_count = child.hit_count
         new_node.external_cache_stored = child.external_cache_stored
+        # The op and its ack cover both fragments.
+        new_node.storage_write_op = child.storage_write_op
+        new_node.storage_stored = child.storage_stored
         new_node.creation_time = child.creation_time
@@ -2228,6 +2235,7 @@ def insert_host(
         new_node.hash_value = hash_value
+        new_node.storage_stored = True
         new_node.component_data[BASE_COMPONENT_TYPE].host_value = host_value.clone()
@@ -2596,6 +2604,42 @@ def finish_write_through(self, node_ids: list[NodeId], ack_id: int) -> None:
             self.kv_events.record_store(node, medium=StorageMedium.CPU)

+    def mark_storage_write(self, node_id: NodeId, op_id: int) -> None:
+        self.node_by_id(node_id).storage_write_op = op_id
+
+    def finish_storage_write(self, node_id: NodeId, op_id: int, *, stored: bool) -> None:
+        """Clear op_id from the node and the split fragments above it, and record whether
+        their pages are stored."""
+        node = self._node_arena.get(node_id)
+        while (
+            node is not None
+            and node is not self.root_node
+            and node.storage_write_op == op_id
+        ):
+            node.storage_write_op = None
+            node.storage_stored = stored
+            node = node.parent
+
+    def unstored_ancestors(self, node_id: NodeId) -> list[NodeId]:
+        """Host-backed ancestors with no storage copy and no write queued, root side first."""
+        found = []
+        node = self.node_by_id(node_id).parent
+        while (
+            node is not None
+            and node is not self.root_node
+            and node.backuped
+            and not node.storage_stored
+            and node.storage_write_op is None
+        ):
+            found.append(node.id)
+            node = node.parent
+        found.reverse()
+        return found
+
+    def clear_storage_marks(self) -> None:
+        """The store was emptied: no node has a storage copy any more."""
+        for node in self._node_arena.values():
+            node.storage_stored = False
+

