--- a/python/sglang/srt/mem_cache/storage/nixl/hicache_nixl.py
+++ b/python/sglang/srt/mem_cache/storage/nixl/hicache_nixl.py
@@ -57,6 +57,11 @@
+# Arbitrary; spreads a chain's stamps so its order survives filesystems that keep
+# coarser stamps than nanoseconds (a 1,000-page chain spans one second).
+_TOUCH_STEP_NS = 1_000_000
+# Arbitrary; one l3_touch line at most this often.
+_TOUCH_LOG_INTERVAL_S = 10.0
@@ -187,4 +192,14 @@ def __init__(
         if self._l3_cleaner is not None:
             self._l3_cleaner.start()
+        # Mtime changes asked by the scheduler thread; None unless a switch is on.
+        self._touch_queue: Optional[queue.SimpleQueue] = None
+        self._touch_thread: Optional[threading.Thread] = None
+        if self.file_manager is not None and nixlconfig.get_touch_enabled():
+            self._touch_queue = queue.SimpleQueue()
+            self._touch_thread = threading.Thread(
+                target=self._touch_loop, name="hicache-l3-touch", daemon=True
+            )
+            self._touch_thread.start()
@@ -620,6 +635,9 @@ def close(self):
         if self._l3_cleaner is not None:
             self._l3_cleaner.stop()
             self._l3_cleaner = None
+        if self._touch_thread is not None:
+            self._touch_queue.put(None)
+            self._touch_thread.join(timeout=5.0)
+            self._touch_thread = None
@@ -879,3 +897,44 @@ def take_stored_write_skips(self) -> int:
         return skipped
+
+    def touch_pages(self, page_keys: List[str], *, newest_ns: Optional[int]) -> None:
+        if self._touch_queue is not None and page_keys:
+            self._touch_queue.put((list(page_keys), newest_ns))
+
+    def _page_file_paths(self, page_key: str) -> List[str]:
+        names = (
+            self._get_key_list_from_meta([page_key])
+            if self.is_zero_copy
+            else [self._get_suffixed_key(page_key)]
+        )
+        return [self.file_manager.get_file_path(name) for name in names]
+
+    def _touch_loop(self) -> None:
+        files = gone = 0
+        last_log = time.monotonic()
+        while True:
+            job = self._touch_queue.get()
+            if job is None:
+                return
+            page_keys, newest_ns = job
+            # Head first: a cleaner scan in the middle of the job sees a refreshed prefix,
+            # never a fresh tail under a stale head.
+            for index, page_key in enumerate(page_keys):
+                stamp = 0 if newest_ns is None else newest_ns - index * _TOUCH_STEP_NS
+                for path in self._page_file_paths(page_key):
+                    try:
+                        os.utime(path, ns=(stamp, stamp))
+                        files += 1
+                    except OSError:
+                        # Never written on this rank, or already deleted by the cleaner.
+                        gone += 1
+            if time.monotonic() - last_log >= _TOUCH_LOG_INTERVAL_S:
+                logger.info("HICACHE_EVT l3_touch files=%d gone=%d", files, gone)
+                files = gone = 0
+                last_log = time.monotonic()

--- a/python/sglang/srt/mem_cache/unified_cache/unified_tree_core.py
+++ b/python/sglang/srt/mem_cache/unified_cache/unified_tree_core.py
@@ class UnifiedTreeNode.__init__ (next to storage_stored)
+        # time.monotonic() of the last mtime refresh queued for the node's pages.
+        self.storage_touched_at = 0.0
@@ _split_node
+        new_node.storage_touched_at = child.storage_touched_at
@@ new methods (next to finish_storage_write)
+    def take_stale_storage_keys(
+        self, node_id: NodeId, *, now: float, min_interval_s: float
+    ) -> list[str]:
+        """Page keys, head first, of the stored nodes from the root down to the deepest node
+        on node_id's path whose last refresh is older than min_interval_s; stamps them. A
+        stale node takes everything above it along, so a head is never older than its tail."""
+        path = []
+        node = self.node_by_id(node_id)
+        while node is not None and node is not self.root_node:
+            path.append(node)
+            node = node.parent
+        stale_from = next(
+            (
+                depth
+                for depth, node in enumerate(path)
+                if node.storage_stored and now - node.storage_touched_at >= min_interval_s
+            ),
+            None,
+        )
+        if stale_from is None:
+            return []
+        page_keys: list[str] = []
+        for node in reversed(path[stale_from:]):
+            if node.storage_stored and node.hash_value:
+                node.storage_touched_at = now
+                page_keys.extend(node.hash_value)
+        return page_keys
+
+    def take_retired_storage_keys(
+        self,
+        tail_node_id: NodeId,
+        *,
+        keep_tokens: int,
+        is_foreign: Callable[[UnifiedTreeNode], bool],
+    ) -> tuple[list[str], list[NodeId]]:
+        """An ended session's own pages: (page keys of its stored nodes, ids of its nodes whose
+        write is still queued). Own means on the tail's root path past the first keep_tokens,
+        below the deepest path node with an off-path child that is_foreign, plus the childless
+        off-path children on the way (replies the next prompt did not repeat). Stored nodes
+        handed out stop counting as stored."""
+        path = []
+        node = self.node_by_id(tail_node_id)
+        while node is not None and node is not self.root_node:
+            path.append(node)
+            node = node.parent
+        end = sum(len(node.key) for node in path)
+        page_keys: list[str] = []
+        pending: list[NodeId] = []
+
+        def take(owned: UnifiedTreeNode) -> None:
+            if owned.storage_write_op is not None:
+                pending.append(owned.id)
+            elif owned.storage_stored and owned.hash_value:
+                owned.storage_stored = False
+                page_keys.extend(owned.hash_value)
+
+        below = None
+        for node in path:                       # tail first
+            start = end - len(node.key)
+            others = [child for child in node.children.values() if child is not below]
+            if start < keep_tokens or any(is_foreign(child) for child in others):
+                break
+            for child in others:
+                take(child)
+            take(node)
+            below, end = node, start
+        return page_keys, pending

