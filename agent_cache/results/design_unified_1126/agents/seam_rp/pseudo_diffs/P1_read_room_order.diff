+    def repark(self, read: ParkedRead) -> None:
+        """Put back a read that dispatch() handed out and that could not launch; it keeps
+        its park time and its place ahead of reads parked since."""
+        if read.handle in self._parked:
+            raise ValueError(f"read for {read.handle} is already parked")
+        self._parked = {read.handle: read, **self._parked}
+        self.stats.dispatched_total -= 1
+        self.stats.room_waits += 1

--- a/python/sglang/srt/mem_cache/unified_radix_cache.py
+++ b/python/sglang/srt/mem_cache/unified_radix_cache.py
