@@ -3296,8 +3357,16 @@
         for decision in decisions:
             operation = decision.read.operation
+            if now < self._room_blocked_until:
+                # An earlier read of this pass is waiting for room: later deadlines wait behind it.
+                srs.repark(decision.read)
+                continue
             operation.start_time = time.monotonic()
             self._launch_storage_hit(operation)
+            if operation.handle in self._reparked:
+                self._reparked.discard(operation.handle)
