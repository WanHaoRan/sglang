-            _, x = heapq.heappop(heap)
+            priority, x = heapq.heappop(heap)
+            # A min-heap: once the smallest is at or past the bound, so is every leaf left.
+            # A parent pushed later is ranked on its own and may still go.
+            if stop_at is not None and priority >= stop_at:
+                break
             if x not in self.tree_core.evictable_host_leaves:
