+                continue
             self._census_dispatching.discard(decision.read.handle)
# ROOM_RETRY_INTERVAL_S = 0.25 (arbitrary; an evict_host call heapifies up to ~740 leaves in campaign 34).
# _room_wait_since / _reparked are cleared in _reset_full, revoke_pending_prefetch and release_aborted_request.
# _read_is_for_a_queued_turn(request): the prefetcher's _positions has the rid (a new hook next to
# census_staged_fn); without a prefetcher every read counts as queued.
# Fix of X2 on the way: the read asks eviction for what it is short of, not for its whole size.

--- a/python/sglang/srt/mem_cache/next_turn_prefetch.py
+++ b/python/sglang/srt/mem_cache/next_turn_prefetch.py
@@ -838,6 +838,8 @@ def _check_queued(
         wait = residual_wait(position=position, rate=rate)
+        if self._queued_slack and wait is not None:
+            self._publish_queued(plan, req=req, admit_at=now + wait, backlog_pages=backlog_pages, now=now)
+
+    def _publish_queued(self, plan, *, req, admit_at, backlog_pages, now) -> None:
+        """Tell eviction when the queued turn is due and how long its resident history
+        would take to read back, on the turn's own deepest resident node and on the
+        session's tail; at most once per PROBE_INTERVAL_S a turn."""
+        if now - plan.last_slack_t < PROBE_INTERVAL_S:
+            return
+        plan.last_slack_t = now
+        parked = self._tree_cache.read_scheduler.parked_pages()
+        reread_s = self._load.seconds(
+            own_pages=math.ceil(req.host_hit_length / self._page_size),
+            backlog_pages=backlog_pages + parked,
+        )
+        queued = Queued(since=plan.arrival_t, admit_at=admit_at, reread_s=reread_s)
+        for node_id in (req.last_host_node, self._session_tail.get(plan.session)):
+            if node_id is not None:
+                self._next_use.register(node_id, queued)
+        plan.queued_node_id = req.last_host_node
@@ -740,6 +742,9 @@ def _on_departure(self, req: Req, *, now: float) -> None:
         plan = self._plans.pop(req.rid, None)
+        if plan is not None and plan.queued_node_id is not None and self._next_use is not None:
+            # Admitted or gone: the node is no longer a queued turn's.
+            self._next_use.forget(plan.queued_node_id)
# req.last_host_node is the NodeId the arrival match set (schedule_batch.py:1156, 1643; root when nothing
# matched: skip the root). Registering it closes X4: today only the previous turn's tail is registered
# (:807-813), which may be gone, and under next_use nothing else of the session is.

