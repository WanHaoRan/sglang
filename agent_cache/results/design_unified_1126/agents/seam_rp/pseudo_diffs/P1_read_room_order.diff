# (the cut and the refusal below are unchanged and are what a read falls back to after the wait limit)
+
+    def _make_read_room(self, request: CacheRequestHandle, alloc_len: int) -> Optional[torch.Tensor]:
+        """Free the pages a read is short of, cheapest holders first; None when only
+        holders that must not yield are left."""
+        pool = self.cache_controller.mem_pool_host
+        strategy = self.tree_core.eviction_strategy
+        queued = self._read_is_for_a_queued_turn(request)
+
+        def short() -> int:
+            return alloc_len - pool.available_size()
+
+        # Idle holders: ended sessions, then idle prefixes in policy order.
+        self.evict_host(short(), stop_at=strategy.host_bound("queued"))
+        # Staged reads of sessions not back; only an arrived turn may take them.
+        if short() > 0 and queued and self.soft_pin_victims_fn is not None:
+            if self._bump_staged_reads(request, short()):
+                self.evict_host(short(), stop_at=strategy.host_bound("queued"))
+        # Queued turns whose history can be read back before their admission, most slack first.
+        if short() > 0 and queued:
+            self.evict_host(short(), stop_at=strategy.host_bound("head"))
+        return pool.alloc(alloc_len) if short() <= 0 else None
+
+    def _wait_for_room(self, operation) -> bool:
+        """Park the read again instead of refusing it: it keeps its anchor lock and its
+        ongoing_prefetch entry, so admission keeps passing its turn over. False once it has
+        waited room_wait_s, or for a staged read, which is left to its turn's arrival."""
+        request = operation.handle
+        now = time.perf_counter()
+        since = self._room_wait_since.setdefault(request, now)
+        if (
+            self._room_wait_s <= 0.0
+            or now - since >= self._room_wait_s
+            or not self._read_is_for_a_queued_turn(request)
+        ):
+            self._room_wait_since.pop(request, None)
+            return False
+        self._room_blocked_until = now + ROOM_RETRY_INTERVAL_S
+        self._reparked.add(request)
+        logger.info(
+            "HICACHE_EVT srs_room_wait rid=%s pages=%d short=%d waited_ms=%d",
+            request.rid, operation.storage_hit_count // self.page_size,
+            operation.storage_hit_count - self.cache_controller.mem_pool_host.available_size(),
+            round((now - since) * 1000),
+        )
+        return True
