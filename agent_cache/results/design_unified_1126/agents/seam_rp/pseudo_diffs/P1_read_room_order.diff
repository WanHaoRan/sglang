# P1: who yields when a read is short of host room.
# Pseudo-diff against HEAD b7074d9cae; not applied. Deadline read order and the next-turn prefetcher only
# (TP = PP = 1); with an LRU policy there are no classes and today's path is kept.
#
# The working tree moved while this was written: at 18:23 UTC on 2026-11-26 someone else added a policy
# option queued_order "lru" | "farthest" to both hint strategies (next_use_eviction.py, +27 lines; a test in
# test_next_use_eviction.py): "farthest" keys the queued tier by -Queued.since, the last arrival first. That is
# this plan's order inside the queued tier without the re-read time and without a head class. Build on it:
# make the slack order a third value of queued_order ("slack": -(admit_at - now - reread_s), head class below
# the margin) through its _queued_score(), rather than the separate edit of get_priority shown below. The
# line numbers here are HEAD's.
#
# Today (unified_radix_cache.py:3038-3078): alloc; evict_host(alloc_len) over every unlocked leaf in policy
# order, the queued tier included (:3041); then, with soft pins on, staged pins of sessions not back (:3043-3047);
# then cut to the room left (:3048-3057); else refuse, revoke and report (:3058-3078).
# With the switch: idle pages -> staged reads -> queued turns with slack -> wait (bounded) -> today's cut/refuse.
#
# Bounding eviction by class: host eviction is one min-heap walk over the evictable host leaves, keyed by the
# policy's priority (components/full.py:242-261). Both hint policies return tuples whose first element is the
# tier (next_use_eviction.py:157-172, 246-271), so a bound is a one-element tuple: (TIER_QUEUED,) compares
# below every queued priority and above every idle one, and the walk stops at the first leaf at or past it
# (checked on the real strategies: ../proto_checks.py B).
#
# A queued turn's slack: the prefetcher's tick already has each queued turn's position and the admission rate
# (next_turn_prefetch.py:645, 652) and computes residual_wait(position, rate) per planned turn in _check_queued
# (:839). Slack = that wait minus the time to read the turn's host-resident history back if it were evicted
# now: L3LoadModel.seconds(own pages = ceil(req.host_hit_length / page), backlog = pages in flight plus pages
# parked). The registration carries the admission time and the re-read time; the strategy subtracts its clock.

--- a/python/sglang/srt/mem_cache/next_use_eviction.py
+++ b/python/sglang/srt/mem_cache/next_use_eviction.py
@@ -44,3 +44,6 @@
 TIER_SOON = 4
 TIER_QUEUED = 5
+# A queued turn whose history could not be read back before its admission: never yields.
+TIER_QUEUED_HEAD = 6
@@ -54,2 +57,3 @@
 RETURN_TIER_QUEUED = 3
+RETURN_TIER_QUEUED_HEAD = 4
+# A queued turn yields only with at least this much slack. As NTP_HOLD_MARGIN_S.
+QUEUED_MIN_SLACK_S = 2.0
@@ -77,5 +81,10 @@ class Queued(msgspec.Struct, frozen=True):
     since: float
+    # Predicted admission (perf_counter seconds) and seconds to read the turn's resident
+    # history back; None until a tick has placed the turn in the queue.
+    admit_at: Optional[float] = None
+    reread_s: float = 0.0
+
+
+def _queued_priority(queued: Queued, *, now: float, tier: int, head_tier: int, node) -> tuple:
+    if queued.admit_at is None:
+        # No slack published (the switch is off): today's key.
+        return (tier, node.last_access_time)
+    slack = queued.admit_at - now - queued.reread_s
+    if slack < QUEUED_MIN_SLACK_S:
+        return (head_tier, node.last_access_time)
+    # Largest slack first.
+    return (tier, -slack)
@@ class EvictionStrategy (evict_policy.py)
+    def host_bound(self, name: str) -> Optional[tuple]:
+        """A priority that every leaf of class `name` and later compares at or above;
+        None when the policy has no such class."""
+        return None
@@ class NextUseStrategy
+    def host_bound(self, name: str) -> Optional[tuple]:
+        return {"queued": (TIER_QUEUED,), "head": (TIER_QUEUED_HEAD,)}.get(name)
@@ -163,4 +180,10 @@ def get_priority(self, node: TreeNode) -> tuple[int, float]:
         if isinstance(next_use, Queued):
             if self._clock() - next_use.since > QUEUED_MAX_AGE_S:
                 return (TIER_UNKNOWN, node.last_access_time)
-            return (TIER_QUEUED, node.last_access_time)
+            return _queued_priority(
+                next_use, now=self._clock(), tier=TIER_QUEUED, head_tier=TIER_QUEUED_HEAD, node=node
+            )
# ReturnChanceStrategy: the same two edits with RETURN_TIER_QUEUED / RETURN_TIER_QUEUED_HEAD (:253-256);
# its three-element tuples take a trailing 0.0.
# Without the switch nobody passes a bound or publishes admit_at, so every priority is today's.
# With it, _on_arrival registers Queued with admit_at at once (position and rate are in hand there, :814-816),
# so no queued turn sits in the yielding tier without a slack.

