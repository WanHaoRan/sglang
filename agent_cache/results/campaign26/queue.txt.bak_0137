# label arm users host_gb oracle_hints hints arrival gap engine timeout [extra server flags]
# controls on today's engines, on the GPU unit the new arms will use (GPU-605dfc41 after the 2026-11-11 02:34Z boot)
jit_p50_ctl three_tier_wc_oracle_v2_nu_owned 44 70 0 dist 0.1 10 engine_owned_20261101 7200
# the expected-cost policy (deck "Pricing the Room"), engine frozen 2026-11-11 04:50Z as engine_ec_20261111b (engine_ec_20261111 released a landed read's pin too eagerly and was never run); base arm = today's JIT p50 arm
# rule 1 alone: expected-cost read start and release at a fixed price, next-use eviction and hard pins as today
# stopped 04:57Z, 30 s into its client, for two defects a code review found (the wait estimate, restaging after a refusal); requeued below on a fixed engine: ec_r1 three_tier_wc_oracle_v2_nu_owned 44 70 0 dist 0.1 10 engine_ec_20261111b 7200 --hicache-storage-next-turn-read-timing expected_cost --hicache-storage-next-turn-memory-price 5e-5
hintfree_ctl three_tier_wc_dl_poll0 44 70 1 oracle 0.1 10 engine_5df71c4bf0_v2 7200
# engine_ec_20261111d, frozen 06:03Z with the fixes of two code reviews (three earlier freezes are deleted; none produced a run).
# Base arm for all: today's JIT p50 arm (gate and hold on, pin fraction 0.3); the extra flags replace its read timing and eviction.
# rules 1 and 3: expected-cost read start at a fixed price, eviction by chance of return within 30 s from the entry's three quantiles
ec_r13 three_tier_wc_oracle_v2_nu_owned 44 70 0 dist 0.1 10 engine_ec_20261111d 7200 --hicache-storage-next-turn-read-timing expected_cost --hicache-storage-next-turn-memory-price 5e-5 --radix-eviction-policy return_chance --radix-eviction-policy-config {"horizon_s":30}
# the rival that uses no gap forecast: reads only at arrival, eviction by the end signal and the queue alone (ended first, queued last, LRU between)
nofc three_tier_wc_oracle_v2_nu_owned 44 70 0 dist 0.1 10 engine_ec_20261111d 7200 --hicache-storage-next-turn-read-timing arrival --radix-eviction-policy return_chance --radix-eviction-policy-config {"score":"lru"}
# rule 1 alone: next-use eviction from the p50 as today
ec_r1 three_tier_wc_oracle_v2_nu_owned 44 70 0 dist 0.1 10 engine_ec_20261111d 7200 --hicache-storage-next-turn-read-timing expected_cost --hicache-storage-next-turn-memory-price 5e-5
# reordered and extended 11:15Z after nofc (0.69 s on the shared turns against 0.66 for ec_r13): unstarted lines only
# the hint-free rival that keeps queued turns' history (the deck's last listed arm): nofc with the end signal ignored too.
# engine_ec_20261111e = engine d plus the eviction score "queue" (ended sessions rank by LRU), frozen 11:14Z
nofc_noend three_tier_wc_oracle_v2_nu_owned 44 70 0 dist 0.1 10 engine_ec_20261111e 7200 --hicache-storage-next-turn-read-timing arrival --radix-eviction-policy return_chance --radix-eviction-policy-config {"score":"queue"}
# reordered 13:20Z after ec_r1 (0.67 s on the shared turns: the read start alone restores JIT p50): unstarted lines only, flags unchanged. The same-build control first, then the repeats, the fixed-quantile rival, rule 4, soft pins, rule 3 alone, 128 users
# added 11:25Z: today's JIT p50 on the new engine with no extra flag, so every arm of the split has a control on one build
jit_p50_d three_tier_wc_oracle_v2_nu_owned 44 70 0 dist 0.1 10 engine_ec_20261111d 7200
# repeats of the two arms that tie: the policy and its forecast-free rival
ec_r13_rep three_tier_wc_oracle_v2_nu_owned 44 70 0 dist 0.1 10 engine_ec_20261111d 7200 --hicache-storage-next-turn-read-timing expected_cost --hicache-storage-next-turn-memory-price 5e-5 --radix-eviction-policy return_chance --radix-eviction-policy-config {"horizon_s":30}
nofc_rep three_tier_wc_oracle_v2_nu_owned 44 70 0 dist 0.1 10 engine_ec_20261111d 7200 --hicache-storage-next-turn-read-timing arrival --radix-eviction-policy return_chance --radix-eviction-policy-config {"score":"lru"}
# the fixed-quantile rival of the deck's replay: just-in-time reads timed to land at the entry's p90, next-use eviction
fq90 three_tier_wc_oracle_v2_nu_owned 44 70 0 dist 0.1 10 engine_ec_20261111d 7200 --hicache-storage-next-turn-landing-quantile 0.9
# rule 4: rules 1 and 3 with the price learned from the harm staged pins do (starts at 5e-5)
ec_r134 three_tier_wc_oracle_v2_nu_owned 44 70 0 dist 0.1 10 engine_ec_20261111d 7200 --hicache-storage-next-turn-read-timing expected_cost --hicache-storage-next-turn-memory-price 5e-5 --hicache-storage-next-turn-price-learning harm --radix-eviction-policy return_chance --radix-eviction-policy-config {"horizon_s":30}
# all four rules: the learned price and soft pins
ec_full three_tier_wc_oracle_v2_nu_owned 44 70 0 dist 0.1 10 engine_ec_20261111d 7200 --hicache-storage-next-turn-read-timing expected_cost --hicache-storage-next-turn-memory-price 5e-5 --hicache-storage-next-turn-price-learning harm --hicache-storage-next-turn-soft-pins on --radix-eviction-policy return_chance --radix-eviction-policy-config {"horizon_s":30}
# rule 3 alone: the base arm's just-in-time timing (lands near the p10), eviction by chance of return within 30 s
ec_r3 three_tier_wc_oracle_v2_nu_owned 44 70 0 dist 0.1 10 engine_ec_20261111d 7200 --radix-eviction-policy return_chance --radix-eviction-policy-config {"horizon_s":30}
# the deck's second setting, 128 users and 160 GB. Changed 15:16Z after nofc_noend at 44 users (0.71 s on the shared turns against 0.69 for nofc): the rival is now the one with no hints at all, then rules 1, 3 and 4 (the price should fall there), then the rival with the end signal
nofc_noend_c128 three_tier_wc_oracle_v2_nu_owned 128 - 0 dist 0.1 10 engine_ec_20261111e 7200 --hicache-storage-next-turn-read-timing arrival --radix-eviction-policy return_chance --radix-eviction-policy-config {"score":"queue"}
ec_r134_c128 three_tier_wc_oracle_v2_nu_owned 128 - 0 dist 0.1 10 engine_ec_20261111d 7200 --hicache-storage-next-turn-read-timing expected_cost --hicache-storage-next-turn-memory-price 5e-5 --hicache-storage-next-turn-price-learning harm --radix-eviction-policy return_chance --radix-eviction-policy-config {"horizon_s":30}
