-            )
+        ahead_pages = in_flight_pages
+        for handle in order:
             read = self._parked[handle]
             deadline = deadlines[handle]
+            if not_before_of is not None:
+                not_before = not_before_of(handle, read, ahead_pages)
+                ahead_pages += read.pages
